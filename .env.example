# Optional default workbook, read from Google Drive: the file ID is the part after /d/ in its link.
# Leave empty to start with no workbook and import sheets from the app instead.
GOOGLE_DRIVE_FILE_ID=

# Name shown for that default workbook in the header switcher.
DEFAULT_WORKBOOK_NAME=Main sheet

# Google credentials, needed for the default workbook above and for "Drive link" imports. Set ONE.
#
# 1) Service account (works for private sheets). Create a service account in Google Cloud,
#    enable the Google Drive API, download its JSON key, and share each sheet with the
#    service account's email as Viewer. Paste the JSON on one line, or base64-encode it.
GOOGLE_SERVICE_ACCOUNT_KEY=
#
# 2) API key (only works for sheets shared as "Anyone with the link can view").
GOOGLE_API_KEY=

# Development: use a local spreadsheet file as the default workbook instead of Google Drive.
# SHEET_FILE_PATH=data/sheet.xlsx

# Where imported spreadsheet workbooks and column mappings are stored. Must be persistent storage.
# WORKBOOKS_DIR=data/workbooks

# ---- Database ----
# PostgreSQL server (PostgreSQL 18+). Leave empty to use the embedded database in PGLITE_DIR,
# which needs no setup but can only be opened by one process at a time.
# DATABASE_URL=postgres://uptrack:password@localhost:5432/uptrack
# DATABASE_POOL_SIZE=10
# PGLITE_DIR=data/pg

# Where screenshots, recordings and API logs are stored. Must be persistent storage.
# STORAGE_DIR=data/storage

# ---- Accounts ----
# Set to false so only people with an invitation can create an account.
# ALLOW_SIGNUPS=true

# Public address of this app, used in invite, share and agent links. Defaults to the request's own origin.
# PUBLIC_URL=https://uptrack.yourcompany.com
