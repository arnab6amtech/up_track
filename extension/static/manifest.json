{
  "manifest_version": 3,
  "name": "UpTrack Bug Capture",
  "short_name": "UpTrack",
  "version": "0.1.0",
  "description": "Screenshot or record a bug with the page's API calls and console errors, and report it to UpTrack.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Report a bug to UpTrack",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabCapture", "offscreen", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page-recorder.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["relay.js"], "run_at": "document_start" }
  ]
}
