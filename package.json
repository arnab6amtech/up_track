{
  "name": "up_track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run ext:build && next build",
    "start": "next start",
    "lint": "eslint",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:check": "tsc -p extension",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.mts",
    "db:import-captures": "tsx --conditions=react-server scripts/import-captures.mts",
    "db:copy-from-pglite": "tsx scripts/db-copy-from-pglite.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.3.0",
    "next": "16.4.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-tools": "^0.4.10",
    "@tailwindcss/turbopack": "^4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fix-webm-duration": "^1.0.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
